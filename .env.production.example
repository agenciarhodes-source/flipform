# FlipForm — Production Environment Example
# Do not commit real secrets.

# Public URLs
NEXT_PUBLIC_MARKETING_URL=https://flipform.com.br
NEXT_PUBLIC_APP_URL=https://app.flipform.com.br
NEXT_PUBLIC_BASE_URL=https://app.flipform.com.br
PUBLIC_SITE_URL=https://flipform.com.br
NEXT_PUBLIC_ADMIN_URL=https://admin.flipform.com.br

# Host routing
APP_HOSTNAME=app.flipform.com.br
ADMIN_HOSTNAME=admin.flipform.com.br

# Database
DATABASE_URL=

# Auth
JWT_SECRET_CURRENT=
JWT_SECRET_PREVIOUS=

# Asaas production
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENV=production

# Transactional email
EMAIL_PROVIDER=smtp
EMAIL_FROM=atendimento@flipform.com.br
EMAIL_REPLY_TO=atendimento@flipform.com.br

# SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true

# Resend, optional alternative to SMTP
RESEND_API_KEY=

# Internal jobs
CRON_SECRET=
INTERNAL_JOB_SECRET=

# Stripe / Flip AI commercial top-ups (server-side only)
# Safe default: test. For commercial production use STRIPE_MODE=live + rk_live_ key
# + the LIVE webhook signing secret + STRIPE_LIVE_PAYMENTS_ALLOWED=true.
# Never commit real keys or webhook secrets.
STRIPE_ENABLED=false
STRIPE_MODE=test
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
# Independent hard gate: must be true only when STRIPE_MODE=live is intentionally enabled.
STRIPE_LIVE_PAYMENTS_ALLOWED=false

# Flip AI credit packages sold to tenants (server-side catalog; never expose internal cost).
# Example item fields: id, name, description, credits, amountCents,
# estimatedOpenAiCostCents, active, sortOrder.
# Keep [] until commercial prices are defined intentionally.
FLIP_AI_CREDIT_PACKAGES_JSON=[]

# OpenAI / Flip AI (server-side only)
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
OPENAI_ORGANIZATION_ID=
# Optional manual reference used only for operational runway estimation
OPENAI_OPERATIONAL_BALANCE_USD=
# Safety buffer applied on top of outstanding Flip AI credit liability (0-100). Default: 20.
FLIP_AI_TREASURY_BUFFER_PERCENT=20

# JEV decision engine + token-budget harness (server-side only).
# Keep disabled until a tenant has been reviewed and explicitly allowlisted.
FLIP_AI_JEV_ENABLED=false
TYPESAFE_API_KEY=
TYPESAFE_JEV_MODEL=jev-latest
FLIP_AI_JEV_TENANT_IDS=
# Internal knowledge budget sent to the OpenAI conversation runtime (400-3000 estimated tokens).
FLIP_AI_HARNESS_TOKEN_BUDGET=1200

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Production guard
ALLOW_EMAIL_PROVIDER_NONE_IN_PRODUCTION=false
ALLOW_SANDBOX_ASAAS_IN_PRODUCTION=false
