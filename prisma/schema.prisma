  contentHash   String   @map("content_hash")
  byteSize      Int      @map("byte_size")
  tokenEstimate Int      @map("token_estimate")
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  index  FlipAiKnowledgeIndex      @relation(fields: [tenantId, indexId], references: [tenantId, id], onDelete: Restrict)
  batch  FlipAiKnowledgeIndexBatch @relation(fields: [tenantId, batchId], references: [tenantId, id], onDelete: Restrict)

  @@unique([indexId, ordinal])
  @@index([tenantId, indexId])
  @@map("flip_ai_knowledge_chunks")
}

model FlipAiUsageEvent {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  agentId      String?  @map("agent_id")
  conversationId String? @map("conversation_id")
  requestKey   String   @unique @map("request_key")
  operation    String
  provider     String
  model        String
  status       String
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  units        Int      @default(1)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agent  FlipAiAgent? @relation(fields: [tenantId, agentId], references: [tenantId, id], onDelete: Restrict)
  conversation Conversation? @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, operation, status])
  @@map("flip_ai_usage_events")
}


model FlipAiConversationState {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  agentId          String   @map("agent_id")
  conversationId   String   @unique @map("conversation_id")
  status           String   @default("active")
  turnCount        Int      @default(0) @map("turn_count")
  summary          String?
  summaryUpdatedAt DateTime? @map("summary_updated_at")
  lastResponseId   String?  @map("last_response_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agent        FlipAiAgent  @relation(fields: [tenantId, agentId], references: [tenantId, id], onDelete: Restrict)
  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, conversationId])
  @@index([tenantId, agentId, status])
  @@map("flip_ai_conversation_states")
}


model FlipAiRateLimitBucket {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  scope         String
  scopeKey      String   @map("scope_key")
  windowStart   DateTime @map("window_start")
  requestCount  Int      @default(0) @map("request_count")
  rejectedCount Int      @default(0) @map("rejected_count")
  lastRequestAt DateTime @default(now()) @map("last_request_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, scope, scopeKey, windowStart])
  @@index([tenantId, windowStart])
  @@index([tenantId, rejectedCount, updatedAt])
  @@map("flip_ai_rate_limit_buckets")
}
